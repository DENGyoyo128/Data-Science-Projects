      <aliases enabled='yes' />
      <column caption='gdp_country_num' datatype='real' name='[Calculation_6921188270123298817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT( REGEXP_REPLACE([gdp_country], &quot;[^0-9.]&quot;, &quot;&quot;) )' />
      </column>
      <column caption='GDP per Capita' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_6921188270123700226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Calculation_6921188270123298817]) / MIN([population_country])' />
      </column>
      <column caption='Billionaires per Million (BPM)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6921188270123933700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([personName]) / ( MIN([population_country]) / 1000000 )' />
      </column>
      <column caption='Self-Made %' datatype='real' name='[Calculation_6921188270126194694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT( IF [selfMade] THEN 1 END )&#10;/ NULLIF( COUNTD([personName]), 0 )' />
      </column>
      <column caption='Education Enrollment %' datatype='real' name='[Calculation_6921188270126366727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([gross_tertiary_education_enrollment])' />
      </column>
      <column caption='Edu by Country' datatype='real' name='[Calculation_6921188270145871885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country] : AVG([gross_tertiary_education_enrollment])}' />
      </column>
      <column caption='Education Bucket' datatype='string' name='[Calculation_6921188270146068494]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  MIN([Calculation_6921188270145871885]) &gt;= WINDOW_PERCENTILE( MIN([Calculation_6921188270145871885]), 0.75 ) THEN &quot;High Edu&quot;&#10;ELSEIF MIN([Calculation_6921188270145871885]) &gt;= WINDOW_PERCENTILE( MIN([Calculation_6921188270145871885]), 0.50 ) THEN &quot;Mid-High Edu&quot;&#10;ELSEIF MIN([Calculation_6921188270145871885]) &gt;= WINDOW_PERCENTILE( MIN([Calculation_6921188270145871885]), 0.25 ) THEN &quot;Mid-Low Edu&quot;&#10;ELSE &quot;Low Edu&quot;&#10;END'>
          <table-calc ordering-field='[federated.1m5r4vp1u8b5fr0zkdhua1nk04jb].[country]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Tax by Country' datatype='real' name='[Calculation_6921188270156935183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country] : AVG([total_tax_rate_country]) }' />
      </column>
      <column caption='Tax Bucket' datatype='string' name='[Calculation_6921188270157074448]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  RANK_PERCENTILE( MIN([Calculation_6921188270156935183]) ) &gt;= 0.75 THEN &quot;High Tax&quot;&#10;ELSEIF RANK_PERCENTILE( MIN([Calculation_6921188270156935183]) ) &gt;= 0.50 THEN &quot;Mid-High Tax&quot;&#10;ELSEIF RANK_PERCENTILE( MIN([Calculation_6921188270156935183]) ) &gt;= 0.25 THEN &quot;Mid-Low Tax&quot;&#10;ELSE &quot;Low Tax&quot;&#10;END'>
          <table-calc ordering-field='[federated.1m5r4vp1u8b5fr0zkdhua1nk04jb].[country]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='LifeExp (country)' datatype='real' name='[Calculation_6921188270180724753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([life_expectancy_country])' />
      </column>
      <column caption='Avg Tycoon Age' datatype='real' name='[Calculation_6921188270180802578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([age])' />
      </column>
      <column caption='Age Gap' datatype='real' name='[Calculation_6921188270180884499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6921188270180802578] - [Calculation_6921188270180724753]' />
      </column>
      <column caption='log bpm' datatype='real' name='[Calculation_6921188270201475095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_6921188270123933700] + 0.001, 10)' />
      </column>
