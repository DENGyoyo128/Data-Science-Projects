          <formatted-text>
            <run fontcolor='#ffffff' fontname='Tableau Bold' fontsize='10'>Efficiency vs. Prosperity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Billionaires Statistics Dataset' name='federated.1m5r4vp1u8b5fr0zkdhua1nk04jb' />
