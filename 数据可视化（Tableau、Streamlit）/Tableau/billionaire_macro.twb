      <table>
        <view>
          <datasources>
            <datasource caption='Billionaires Statistics Dataset' name='federated.1m5r4vp1u8b5fr0zkdhua1nk04jb' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1m5r4vp1u8b5fr0zkdhua1nk04jb'>
            <column caption='gdp_country_num' datatype='real' name='[Calculation_6921188270123298817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT( REGEXP_REPLACE([gdp_country], &quot;[^0-9.]&quot;, &quot;&quot;) )' />
            </column>
            <column caption='GDP per Capita' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_6921188270123700226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Calculation_6921188270123298817]) / MIN([population_country])' />
            </column>
            <column caption='Billionaires per Million (BPM)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6921188270123933700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([personName]) / ( MIN([population_country]) / 1000000 )' />
            </column>
            <column caption='log bpm' datatype='real' name='[Calculation_6921188270201475095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOG([Calculation_6921188270123933700] + 0.001, 10)' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Final Worth' datatype='integer' name='[finalWorth]' role='measure' type='quantitative' />
            <column caption='Gdp Country' datatype='string' name='[gdp_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Person Name' datatype='string' name='[personName]' role='dimension' type='nominal' />
            <column caption='Population Country' datatype='real' name='[population_country]' role='measure' type='quantitative' />
            <column-instance column='[finalWorth]' derivation='Sum' name='[sum:finalWorth:qk]' pivot='key' type='quantitative' />
