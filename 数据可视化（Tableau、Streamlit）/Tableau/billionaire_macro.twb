            <column caption='Person Name' datatype='string' name='[personName]' role='dimension' type='nominal' />
            <column-instance column='[finalWorth]' derivation='Sum' name='[sum:finalWorth:qk]' pivot='key' type='quantitative' />
            <column caption='Total Tax Rate Country' datatype='real' name='[total_tax_rate_country]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6921188270157074448]' derivation='User' name='[usr:Calculation_6921188270157074448:nk:3]' pivot='key' type='nominal'>
              <table-calc ordering-field='[federated.1m5r4vp1u8b5fr0zkdhua1nk04jb].[country]' ordering-type='Field' />
